# Live Polling System - Backend Environment Configuration

# Server Port
PORT=8080

# MongoDB Configuration (Local or Cloud MongoDB Atlas)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=live_polling_db

# Redis Configuration (Local or Cloud Upstash Redis)
# Example Local: redis://localhost:6379
# Example Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URI=redis://localhost:6379

# JWT Authentication Secret Key
JWT_SECRET=your-secure-random-jwt-secret-key-replace-in-production

# CORS Allowed Origin (set to frontend domain in production, e.g. https://your-app.vercel.app)
CORS_ORIGIN=*

# Environment: development or production
ENV=development
